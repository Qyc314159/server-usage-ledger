# 复制为 .env 并填写。.env 不要提交到任何仓库。
# 飞书自建应用凭据（在 open.feishu.cn/app 创建，开 docx:document 权限）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

*** 台账文档 token（飞书文档 URL 里 /docx/<这一串>；非密钥）
FEISHU_DOC_TOKEN=
*** 可选：设置后 `ledger.mjs where` 直接打印它
FEISHU_DOC_URL=

*** 可选：API 主机。默认 https://open.feishu.cn ；飞书国际版 Lark 填 https://open.larksuite.com
FEISHU_BASE_URL=
*** 可选：滚动窗口半径（天）。默认 3 → 今天 ±3 天
LEDGER_WINDOW_DAYS=3
